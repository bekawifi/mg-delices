{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MG DELICES",
  "version": "1.0.1",
  "identifier": "com.mgdelices.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' asset: https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    },
    "windows": [{
      "title": "MG DELICES",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "nsis": { "displayLanguageSelector": false, "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNEFGQUM0Mjc3QjYyMkIKUldRclluc254UHBLdmdzbGQzejJoR051VmVTUFgxYzBoaGZpellYay9Pc1pjOUF5VzJwQ2JTQ3YK",
      "endpoints": [
        "https://github.com/bekawifi/mg-delices/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
