    "test:supabase:step6": "node --env-file=.env.test.local supabase/tests/step6.integration.mjs",
    "test:supabase:step7": "node --env-file=.env.test.local supabase/tests/step7.integration.mjs",
    "test:supabase:step9": "node --env-file=.env.test.local supabase/tests/step9.integration.mjs",
    "test:supabase:step10b": "node --env-file=.env.test.local supabase/tests/step10b.integration.mjs",
